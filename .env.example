# Online sync between devices (Firebase Firestore). Leave empty to keep the app local-only.
# Copy this file to .env.local, fill in the values, then run `npm run build` again.
# These values are baked into the app at build time (on Vercel: add them under Settings -> Environment Variables).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional:
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# A long secret code of your own choosing (letters, numbers, - or _; at least 12 characters).
# All your devices must use the SAME code. It must also be pasted into firestore.rules.
NEXT_PUBLIC_WORKSPACE_CODE=
